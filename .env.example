# ---------- Dashboard login ----------
# The password for /admin. Required in production. The owner can later change
# it from Dashboard > Password (that stored password overrides this one).
ADMIN_PASSWORD=change-me

# Optional: signs the login cookie. If omitted, one is derived from
# ADMIN_PASSWORD. Set a long random string in production.
# ADMIN_SESSION_SECRET=

# ---------- Storage provider (pick ONE) ----------
# Auto-detected from whichever keys are present. Force one with:
# CONTENT_PROVIDER=vercel-blob | supabase | local

# Option A (recommended on Vercel): Vercel Blob.
# Vercel dashboard > Storage > Create Blob store > Connect to project.
# Vercel injects this automatically; only set it locally if you want to use
# the real store from your machine.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Option B: Supabase. Run supabase/schema.sql in the SQL editor first.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_MEDIA_BUCKET=media

# With neither set, content is written to ./content/site.json and uploads to
# ./public/uploads (development only).
